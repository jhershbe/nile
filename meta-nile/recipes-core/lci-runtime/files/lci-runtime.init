#!/bin/sh

DAEMON=/usr/local/natinst/bin/vb8034Daemon
NAME=vb8034Daemon

lci_value() {
    sed -n "s/.*g_lci\\.$1=\\([^ ]*\\).*/\\1/p" /proc/cmdline
}

lci_string() {
    sed -n "s/.*g_lci\\.$1=\"\\([^\"]*\\)\".*/\\1/p" /proc/cmdline
}

case "$1" in
    start)
        test -x "$DAEMON" || exit 0
        id_vendor=$(lci_value idVendor)
        id_product=$(lci_value idProduct)
        serial_number=$(lci_value iSerialNumber)
        manufacturer=$(lci_string manufacturer)
        product=$(lci_string product)
        cdrom=$(lci_value cdrom)
        backing_file=$(lci_value file)
        if test -z "$id_vendor" || test -z "$id_product" || \
           test -z "$serial_number" || test -z "$product" || \
           test -z "$cdrom" || test -z "$backing_file"; then
            echo "Missing g_lci parameters in /proc/cmdline" >&2
            exit 1
        fi
        /sbin/modprobe usb_f_hid_bulk || exit $?
        set -- idVendor="$id_vendor" idProduct="$id_product" \
            iSerialNumber="$serial_number" product="$product" \
            cdrom="$cdrom" file="$backing_file"
        test -z "$manufacturer" || set -- "$@" manufacturer="$manufacturer"
        /sbin/modprobe g_lci "$@" || exit $?
        # Wait for udev to apply the lvuser ownership of the new hidg nodes.
        udevadm settle
        mkdir -p /var/run/natinst
        chown lvuser:ni /var/run/natinst
        chmod 775 /var/run/natinst
        # The daemon gives DMA poll threads SCHED_FIFO max priority (legacy
        # granted CAP_SYS_NICE); without it MSO runs with digital lines fail.
        ulimit -r 99
        start-stop-daemon -S -q -o -b -c lvuser:ni -n "$NAME" -a "$DAEMON"
        ;;
    stop)
        start-stop-daemon -K -q -n "$NAME"
        ;;
    restart)
        "$0" stop
        "$0" start
        ;;
    *)
        echo "Usage: $0 {start|stop|restart}" >&2
        exit 1
        ;;
esac

exit 0
