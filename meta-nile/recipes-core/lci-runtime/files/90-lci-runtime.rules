# vb8034Daemon runs as lvuser:ni (legacy /etc/fix_permissions equivalents).
SUBSYSTEM=="uio", KERNEL=="uio0", OWNER="lvuser", GROUP="ni"
SUBSYSTEM=="hidgb", OWNER="lvuser", GROUP="ni"
SUBSYSTEM=="hidg_bulk", OWNER="lvuser", GROUP="ni"
# libnitargetcfg reads the U-Boot environment through fw_printenv.
SUBSYSTEM=="ubi", KERNEL=="ubi0", MODE="0644"
SUBSYSTEM=="ubi", ATTR{name}=="u-boot-env[12]", MODE="0644"
# The System Web Server (webserv) reads the U-Boot environment MTDs directly.
SUBSYSTEM=="mtd", ATTR{name}=="u-boot-env[12]", MODE="0644"
