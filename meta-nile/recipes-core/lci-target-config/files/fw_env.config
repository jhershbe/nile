# Configuration file for fw_(printenv/saveenv) utility.
# Up to two entries are valid, in this case the redundant
# environment sector is assumed present.

# The environment lives in the u-boot-env1/2 UBI volumes; libubootenv reads
# them directly (the legacy /dev/mtd4-5 gluebi layout does not pass CRC here).
# UBI volume name       Device offset   Env. size
/dev/ubi0:u-boot-env1   0x0000          0x20000
/dev/ubi0:u-boot-env2   0x0000          0x20000
